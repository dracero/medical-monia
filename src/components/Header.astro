---
// src/components/Header.astro
---

<header class="app-header glass-panel">
  <div class="brand-section">
    <div class="brand-logo-icon">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
    </div>
    <div>
      <div class="brand-title">
        <span>MONAI Pathology Lab</span>
        <span class="brand-badge">Tissue-Agnostic</span>
      </div>
      <div style="font-size: 0.72rem; color: var(--text-muted); font-family: var(--font-mono);">
        Extracción Multiescalar (Macroestructura & Microestructura)
      </div>
    </div>
  </div>

  <div class="header-actions">
    <!-- Upload Custom Image Button (ANY TISSUE) -->
    <input type="file" id="custom-image-file" accept="image/*" style="display: none;" />
    <button id="upload-image-btn" class="btn btn-secondary" title="Sube una foto o corte histológico de cualquier tejido para extraer macro y microestructura real">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="17 8 12 3 7 8"></polyline>
        <line x1="12" y1="3" x2="12" y2="15"></line>
      </svg>
      <span>Subir Mi Propia Imagen</span>
    </button>

    <!-- Ephemeral In-Memory Session Badge & Reset Button -->
    <div class="session-badge" style="display: flex; align-items: center; gap: 6px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 9999px; padding: 4px 10px; font-size: 0.72rem;">
      <span style="width: 7px; height: 7px; border-radius: 50%; background: #10b981; box-shadow: 0 0 6px #10b981;"></span>
      <span style="color: #6ee7b7; font-weight: 600;">Sesión en RAM</span>
    </div>

    <!-- Prominent Reset Session Button -->
    <button id="reset-session-btn" class="btn btn-secondary" style="border-color: rgba(239, 68, 68, 0.4); color: #fca5a5; display: flex; align-items: center; gap: 6px;" title="Borra todas las segmentaciones, máscaras y anotaciones en memoria, dejando la imagen base limpia">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
        <path d="M3 3v5h5"></path>
      </svg>
      <span>Reiniciar Sesión</span>
    </button>

    <!-- Backend Status Pill -->
    <div id="backend-status-pill" class="status-pill" title="Checking local FastAPI + MONAI engine status">
      <span class="status-indicator"></span>
      <span id="backend-status-text">GPU: Conectando...</span>
    </div>

    <!-- Info / Architecture Guide Modal Trigger -->
    <button id="open-arch-modal-btn" class="btn btn-secondary" title="Ver Arquitectura Técnica">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <span>Docs</span>
    </button>

    <!-- Export GeoJSON -->
    <button id="export-geojson-btn" class="btn btn-primary" title="Exportar anotaciones en formato estándar QuPath / GeoJSON">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      <span>Exportar GeoJSON</span>
    </button>
  </div>
</header>

<script>
  const statusPill = document.getElementById('backend-status-pill');
  const statusText = document.getElementById('backend-status-text');

  async function checkBackendHealth() {
    try {
      const res = await fetch('http://localhost:8000/health', { method: 'GET', signal: AbortSignal.timeout(2000) });
      if (res.ok) {
        const data = await res.json();
        if (statusText) statusText.textContent = `MONAI GPU: ${data.device}`;
        if (statusPill) {
          statusPill.style.background = 'rgba(16, 185, 129, 0.15)';
          statusPill.style.borderColor = 'rgba(16, 185, 129, 0.4)';
          statusPill.style.color = '#34d399';
        }
      } else {
        throw new Error('Non-200');
      }
    } catch (e) {
      if (statusText) statusText.textContent = 'Conectando Backend...';
      if (statusPill) {
        statusPill.style.background = 'rgba(6, 182, 212, 0.15)';
        statusPill.style.borderColor = 'rgba(6, 182, 212, 0.4)';
        statusPill.style.color = '#38bdf8';
      }
    }
  }

  checkBackendHealth();
  setInterval(checkBackendHealth, 8000);

  const uploadBtn = document.getElementById('upload-image-btn');
  const fileInput = document.getElementById('custom-image-file');
  uploadBtn?.addEventListener('click', () => {
    fileInput?.click();
  });

  const resetSessionBtn = document.getElementById('reset-session-btn');
  resetSessionBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('app:reset-session'));
  });
</script>
