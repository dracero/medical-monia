---
// src/pages/index.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import LeftSidebar from '../components/LeftSidebar.astro';
import Viewer from '../components/Viewer.astro';
import RightSidebar from '../components/RightSidebar.astro';
import ArchitectureModal from '../components/ArchitectureModal.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="PoC Full-Stack de Histopatología Digital: Segmentación Semántica con MONAI y Zero-Shot con SAM-2 sobre tejidos sanos en tiempo real." />
    <meta name="theme-color" content="#07090e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>MONAI Pathology Lab — Histología y Tejidos Sanos (Zero-Shot & Semántica)</title>
  </head>
  <body>
    <div class="app-layout">
      <!-- Top Clinical Navigation Header -->
      <Header />

      <!-- Main Tri-Pane Pathology Workstation -->
      <main class="workspace-grid">
        <!-- Left: Interactive Tools, Prompts & Model Selector -->
        <LeftSidebar />

        <!-- Center: High-Performance Canvas & Microscope Viewport -->
        <Viewer />

        <!-- Right: Morphometric Diagnostics & Segmented Layers -->
        <RightSidebar />
      </main>

      <!-- Technical Architecture & No-LLM Specs Modal -->
      <ArchitectureModal />
    </div>
  </body>
</html>
