# ==============================================================================
# .gitignore for MONAI Pathology Workstation (Full-Stack Astro + Python/CUDA)
# ==============================================================================

# --- Node & Frontend Build (Astro / Vite) ---
node_modules/
dist/
.astro/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
.uv/

# --- PyTorch, MONAI & Model Checkpoints ---
# Exclude heavy model weights / checkpoint binaries (downloaded via HF/torch at runtime)
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.engine
checkpoints/
models_cache/
.cache/
wandb/

# --- Heavy Digital Pathology / Whole Slide Images (WSI) ---
# Prevent accidentally committing multi-gigabyte histological slide scans
*.svs
*.ndpi
*.mrxs
*.scn
*.bif
*.vms
*.vmu
*.dcm
*.nii
*.nii.gz

# Keep demo sample images in public/
!public/samples/
!public/samples/*.jpg
!public/samples/*.png

# --- Environment Variables & Secrets ---
.env
.env.production
.env.development
.env.local
.env.*.local
*.pem
*.key

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Antigravity / AI Agent temporary workspaces
.gemini/
.agents/
